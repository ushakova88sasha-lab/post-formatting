# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# ID канала: @channel_username или числовой -1001234567890
TELEGRAM_CHANNEL_ID=@your_channel
# Опционально: HTTP/HTTPS-прокси для запросов к Telegram API
# Пример: http://user:password@proxy.example.com:8080
PROXY=

# Админ (одна учётка)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_strong_password
SESSION_SECRET=change_me_to_random_long_string

# Сервер
HOST=0.0.0.0
PORT=8000

# База (SQLite-файл, отдельный сервер БД не нужен)
DATABASE_URL=sqlite:///./data/posts.db

# Публичный URL сервера (для картинок в Telegram — только HTTP/HTTPS)
PUBLIC_BASE_URL=http://your-server-ip:8000
